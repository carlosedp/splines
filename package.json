{
  "name": "splines",
  "version": "0.1.0",
  "private": true,
  "description": "A community catalog of norns & grid scripts, built as a static site with a maiden-compatible catalog.",
  "type": "module",
  "scripts": {
    "validate": "node tools/validate.mjs",
    "validate:online": "node tools/validate.mjs --online",
    "enrich": "node tools/enrich.mjs",
    "import": "node tools/import.mjs",
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs",
    "dev": "node tools/build.mjs && node tools/serve.mjs --watch",
    "new": "node tools/new-entry.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "marked": "^14.1.0",
    "yaml": "^2.5.0"
  }
}
